{
  "name": "bramblepost",
  "version": "0.1.0",
  "private": true,
  "description": "Bramblepost: a cosy tile-sliding puzzle about Pip the hedgehog postman.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "solve": "tsx tools/solve.ts",
    "budget": "tsx tools/budget.ts",
    "gen": "tsx tools/gen.ts",
    "scramble": "tsx tools/scramble.ts"
  },
  "engines": {
    "node": ">=22.22"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
